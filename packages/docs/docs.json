{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "@slopcode-ai/docs",
  "colors": {
    "primary": "#5A5858",
    "light": "#656363",
    "dark": "#211E1E"
  },
  "favicon": "/favicon-v3.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "memory", "development"],
            "openapi": "https://slopcode.dev/openapi.json"
          }
        ]
      }
    ],
    "global": {}
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@slopcode.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "SlopCode",
      "href": "https://slopcode.dev"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/slopcode",
      "github": "https://github.com/teamslop/slopcode"
    }
  }
}
