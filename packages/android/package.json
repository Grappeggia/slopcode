{
  "name": "@slopcode-ai/android",
  "version": "0.2.215",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test src && bun run test:visual",
    "test:visual": "playwright test --config=playwright.config.ts",
    "build:web": "vite build",
    "build:android": "./gradlew :app:assembleDebug",
    "test:android-ui": "bun run build:web && ./gradlew :app:connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=dev.slopcode.android.AndroidUiInstrumentedTest",
    "build": "bun run build:web && bun run build:android"
  },
  "dependencies": {
    "@slopcode-ai/app": "workspace:*",
    "@solidjs/router": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
