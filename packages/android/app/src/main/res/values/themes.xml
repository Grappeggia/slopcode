<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Slopcode" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>

    <style name="Theme.Slopcode.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Slopcode</item>
    </style>
</resources>
