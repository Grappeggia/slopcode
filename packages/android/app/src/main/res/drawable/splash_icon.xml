    <item android:insetLeft="36dp" android:insetTop="28dp" android:insetRight="36dp" android:insetBottom="28dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/launch_cutout" />
        </shape>
    </item>
    <item android:insetLeft="58dp" android:insetTop="44dp" android:insetRight="20dp" android:insetBottom="44dp">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/launch_surface" />
        </shape>
    </item>
</layer-list>
