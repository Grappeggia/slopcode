{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "SLOPCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "SLOPCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "slopcode#test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@slopcode-ai/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@slopcode-ai/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
